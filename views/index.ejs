<%- include("partials/header") %>

<main>
  <section class="task-header">
    <div>
      <h2>Your tasks</h2>
      <p>Pending: <strong><%= pendingCount %></strong> • Completed: <strong><%= completedCount %></strong></p>
      <p>Showing: <strong><%= filter === 'all' ? 'All' : filter.charAt(0).toUpperCase() + filter.slice(1) %></strong></p>
    </div>

    <form method="POST" action="/tasks/create" class="task-form">
      <input type="text" name="title" placeholder="Enter task" required>
      <button>Add Task</button>
    </form>
  </section>

  <nav class="task-filters">
    <a href="/tasks" class="<%= filter === 'all' ? 'active' : '' %>">All</a>
    <a href="/tasks?status=pending" class="<%= filter === 'pending' ? 'active' : '' %>">Pending</a>
    <a href="/tasks?status=completed" class="<%= filter === 'completed' ? 'active' : '' %>">Completed</a>
  </nav>

  <% if (tasks.length === 0) { %>
    <p class="empty-state">No tasks yet. Add your first task to get started.</p>
  <% } else { %>
    <ul class="task-list">
      <% tasks.forEach(task => { %>
        <li class="task-item <%= task.status %>">
          <span><%= task.title %></span>
          <small><%= task.status %></small>

          <div class="task-actions">
            <% if (task.status !== "completed") { %>
              <form action="/tasks/complete/<%= task._id %>" method="POST">
                <button type="submit">Complete</button>
              </form>
            <% } %>
            <form action="/tasks/delete/<%= task._id %>" method="POST">
              <button type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include("partials/footer") %>
<h2>Login</h2>
<form action="/login" method="POST">
  <input name="username" placeholder="Username" required />
  <input name="password" type="password" placeholder="Password" required />
  <button>Login</button>
</form>

<h3>Register</h3>
<form action="/register" method="POST">
  <input name="username" placeholder="Username" required />
  <input name="password" type="password" placeholder="Password" required />
  <button>Register</button>
</form>